# ============================================
# SECRETS FILE TEMPLATE
# ============================================
# Copy this file to application.properties.secrets and fill in your actual values

# Database Credentials
db.username=your_postgres_username
db.password=your_postgres_password

# JWT Secret Key (generate a random base64 string)
jwt.secret=your_jwt_secret_key_here_make_it_long_and_random

# OAuth2 Google Credentials
oauth2.google.client-id=YOUR_GOOGLE_CLIENT_ID
oauth2.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
